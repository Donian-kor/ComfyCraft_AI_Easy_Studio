             <property name="maximumSize">
              <size>
               <width>16777215</width>
               <height>16777215</height>
              </size>
             </property>
             <property name="toolTip">
              <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;SCHEDULER_OPTIONS &lt;/p&gt;&lt;p&gt;    (&amp;quot;normal&amp;quot;, &amp;quot;가장 무난하고 기본적인 노이즈 스케줄입니다.&amp;quot;),&lt;/p&gt;&lt;p&gt;    (&amp;quot;karras&amp;quot;, &amp;quot;고화질 이미지 생성에 강하며 디테일을 살리는 데 효과적입니다.&amp;quot;),&lt;/p&gt;&lt;p&gt;    (&amp;quot;exponential&amp;quot;, &amp;quot;지수적으로 변화하며 부드러운 감쇠를 제공합니다.&amp;quot;),&lt;/p&gt;&lt;p&gt;    (&amp;quot;sgm_uniform&amp;quot;, &amp;quot;SGM 노이즈 스케줄을 사용하며 일정한 간격을 가집니다.&amp;quot;),&lt;/p&gt;&lt;p&gt;    (&amp;quot;simple&amp;quot;, &amp;quot;복잡한 계산 없이 단순한 선형 스케줄입니다.&amp;quot;),&lt;/p&gt;&lt;p&gt;    (&amp;quot;ddim_uniform&amp;quot;, &amp;quot;DDIM의 균일한 노이즈 스케줄을 따릅니다.&amp;quot;),&lt;/p&gt;&lt;p&gt;    (&amp;quot;beta&amp;quot;, &amp;quot;베타 분포를 따르는 노이즈 스케줄입니다.&amp;quot;),&lt;/p&gt;&lt;p&gt;    (&amp;quot;linear_quadratic&amp;quot;, &amp;quot;선형과 이차 함수가 혼합된 독특한 스케줄입니다.&amp;quot;),&lt;/p&gt;&lt;p&gt;    (&amp;quot;kl_optimal&amp;quot;, &amp;quot;KL 발산을 최적화하여 수렴 속도를 높입니다.&amp;quot;),&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
             </property>
