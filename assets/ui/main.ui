             <property name="toolTip">
              <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;SAMPLER_OPTIONS&lt;/p&gt;&lt;p&gt;(&amp;quot;dpmpp_2m_sde&amp;quot;, &amp;quot;SDE 기반으로 디테일이 뛰어나며, 부드러운 결과물을 생성합니다.&amp;quot;),&lt;/p&gt;&lt;p&gt;(&amp;quot;dpmpp_2m&amp;quot;, &amp;quot;가장 보편적으로 사용되며 속도와 품질의 균형이 훌륭합니다.&amp;quot;),&lt;/p&gt;&lt;p&gt;(&amp;quot;euler&amp;quot;, &amp;quot;빠르고 안정적이며 깔끔한 결과물을 원할 때 적합합니다.&amp;quot;),&lt;/p&gt;&lt;p&gt;(&amp;quot;euler_ancestral&amp;quot;, &amp;quot;매 스텝마다 노이즈를 추가하여 다양한 변형을 시도합니다.&amp;quot;),&lt;/p&gt;&lt;p&gt;(&amp;quot;lcm&amp;quot;, &amp;quot;적은 스텝(4~8)으로도 빠르게 생성할 수 있습니다.&amp;quot;),&lt;/p&gt;&lt;p&gt;(&amp;quot;ddim&amp;quot;, &amp;quot;일관성이 높고 안정적인 생성을 보장합니다.&amp;quot;),&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
             </property>
