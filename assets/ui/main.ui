    background-color: #1d212c;
    color: #9aa2b8;
    border: 1px solid #262b3a;
    border-bottom: none;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    padding: 10px 24px;
    margin-right: 4px;
    font-weight: 500;
    font-size: 13px;
}
QTabBar::tab:hover {
    background-color: #262b3a;
    color: #e8eaf0;
}
