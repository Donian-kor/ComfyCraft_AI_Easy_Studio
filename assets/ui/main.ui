<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1663</width>
    <height>990</height>
   </rect>
  </property>
  <property name="minimumSize">
   <size>
    <width>1323</width>
    <height>810</height>
   </size>
  </property>
  <property name="font">
   <font>
    <family>Segoe UI</family>
    <pointsize>-1</pointsize>
   </font>
  </property>
  <property name="windowTitle">
   <string>ComfyUI + LMStudio Generator v0.3</string>
  </property>
  <property name="styleSheet">
   <string notr="true">/* ================================================================
   NEW UI v2.0 – HTML 대시보드 스타일 (전체 적용)
   ================================================================ */

/* ---------- 전역 설정 ---------- */
QMainWindow,
QWidget#centralWidget {
    background-color: #f1f5f9;
    color: #0f172a;
    font-family: &quot;Segoe UI&quot;, &quot;Malgun Gothic&quot;, &quot;Segoe UI Emoji&quot;, Arial, sans-serif;
    font-size: 13px;
}

/* ---------- 메인 스플리터 ---------- */
QSplitter::handle {
    background-color: #e2e8f0;
    width: 2px;
    height: 2px;
}
QSplitter::handle:hover {
    background-color: #94a3b8;
}

/* ---------- 탭 위젯 ---------- */
QTabWidget#mainModeTabWidget::pane {
    background-color: transparent;
    border: none;
    border-radius: 16px;
}

QTabWidget#mainModeTabWidget QTabBar::tab {
    background-color: #ffffff;
    color: #475569;
    border: 1px solid #e2e8f0;
    border-bottom: none;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    padding: 10px 24px;
    margin-right: 4px;
    font-weight: 500;
    font-size: 13px;
}

QTabWidget#mainModeTabWidget QTabBar::tab:selected {
    background-color: #ffffff;
    color: #0f172a;
    border-color: #cbd5e1;
    border-bottom: 2px solid #3b82f6;
}

QTabWidget#mainModeTabWidget QTabBar::tab:hover:!selected {
    background-color: #f8fafc;
    color: #1e293b;
}

/* ---------- 모든 QGroupBox (카드) ---------- */
QGroupBox {
    background-color: #f1f5f9;
    border: 1px solid #e9edf2;
    border-radius: 16px;
    margin-top: 8px;
    padding: 16px 20px 20px 20px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 16px;
    padding: 0 8px;
    background-color: #f1f5f9;
    color: #1e293b;
    font-size: 20px;
    font-weight: 600;
}

/* 설정 탭 연결 패널 */
QGroupBox#connectionPanel {
    background-color: #f1f5f9;
    border: 1px solid #e9edf2;
    border-radius: 16px;
    padding: 24px 20px;
}

/* LM / Comfy 내부 카드 */
QGroupBox#lmgroupBox,
QGroupBox#ComfygroupBox {
    background-color: #f1f5f9;
    border: 1px solid #e9edf2;
    border-radius: 16px;
    padding: 18px 20px 20px 20px;
}

/* ---------- 라벨 ---------- */
QLabel {
    background-color: transparent;
    color: #0f172a;
}

/* 상태 배지 - 배경/테두리 제거 (투명) */
QLabel#lmStatusLabel,
QLabel#comfyStatusLabel {
    background-color: transparent;  /* ⬅️ 배경을 투명하게 */
    border: none;                   /* ⬅️ 테두리 완전 제거 */
    padding: 4px 14px 4px 10px;     /* (선택) 패딩도 없애려면 0px로 */
    font-size: 13px;
    font-weight: 500;
    color: #0f172a;
}

/* 상태 텍스트 색상 */
QLabel#lmStatusLabel[text*=&quot;연결 성공&quot;],
QLabel#comfyStatusLabel[text*=&quot;연결 성공&quot;] {
    color: #065f46;
}
QLabel#lmStatusLabel[text*=&quot;연결 실패&quot;],
QLabel#comfyStatusLabel[text*=&quot;연결 실패&quot;] {
    color: #991b1b;
}

/* 모델 경로 상태 */
QLabel#modelPathStatusLabel {
    font-size: 12px;
    color: #64748b;
    font-family: &quot;Cascadia Code&quot;, &quot;Consolas&quot;, monospace;
}

/* 프롬프트 카운터 */
QLabel#positivePromptCounterLabel,
QLabel#negativePromptCounterLabel {
    color: #94a3b8;
    font-size: 12px;
}

/* 카드 제목 */
QLabel#lmTitleLabel,
QLabel#comfyTitleLabel {
    font-weight: bold;
    font-size: 20px;
    color: #0f172a;
}

/* ---------- 입력 필드 ---------- */
QLineEdit,
QPlainTextEdit,
QTextEdit {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #d1d9e6;
    border-radius: 10px;
    padding: 8px 14px;
    selection-background-color: #bfdbfe;
    selection-color: #0f172a;
}

QLineEdit:hover,
QPlainTextEdit:hover,
QTextEdit:hover {
    border-color: #94a3b8;
}

QLineEdit:focus,
QPlainTextEdit:focus,
QTextEdit:focus {
    border-color: #3b82f6;
    background-color: #fafcff;
}

/* 서버 주소 입력창 */
QLineEdit#lmUrlEdit,
QLineEdit#comfyUrlEdit,
QLineEdit#comfyModelPathEdit {
    background-color: #f1f4f9;
    border: 1px solid #e9edf2;
    border-radius: 10px;
    padding: 10px 16px;
    font-family: &quot;Cascadia Code&quot;, &quot;Consolas&quot;, monospace;
    font-size: 14px;
    color: #1e293b;
}

/* ---------- 콤보박스 (CSS 삼각형 화살표로 강제 표시) ---------- */
QComboBox {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #d1d9e6;
    border-radius: 10px;
    padding: 8px 14px;
    min-height: 24px;
}
QComboBox:hover {
    border-color: #94a3b8;
}
QComboBox:focus {
    border-color: #3b82f6;
}

/* 드롭다운 영역 넓히기 */
QComboBox::drop-down {
    border: none;
    width: 30px; /* 화살표가 들어갈 공간 확보 */
    background: transparent;
}

/* 🚀 핵심 해결책: CSS 삼각형으로 화살표 직접 그리기 (OS 영향 없음) */
QComboBox::down-arrow {
    image: none;            /* ⭐ 기본 화살표 이미지를 강제로 제거 (이게 핵심!) */
    width: 0;
    height: 0;
    border-left: 6px solid transparent;
    border-right: 6px solid transparent;
    border-top: 6px solid #64748b; /* 화살표 색상 (원하는 색으로 변경 가능) */
    margin: 0px;
}

/* 드롭다운 목록 스타일 */
QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #d1d9e6;
    border-radius: 10px;
    padding: 4px;
    selection-background-color: #eff6ff;
    selection-color: #1e293b;
}
QComboBox QAbstractItemView::item:hover {
    background-color: #f1f5f9;
}

/* ---------- 스핀박스 ---------- */
QSpinBox,
QDoubleSpinBox {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #d1d9e6;
    border-radius: 10px;
    padding: 6px 10px;
    min-height: 20px;
}
QSpinBox:hover,
QDoubleSpinBox:hover {
    border-color: #94a3b8;
}
QSpinBox:focus,
QDoubleSpinBox:focus {
    border-color: #3b82f6;
}
QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    width: 16px;
    border: none;
    background-color: transparent;
}

/* ---------- 버튼 ---------- */
QPushButton {
    background-color: #ffffff;
    color: #1e293b;
    border: 1px solid #d1d9e6;
    border-radius: 8px;
    padding: 6px 16px;
    font-size: 13px;
    font-weight: 500;
}
QPushButton:hover {
    background-color: #f8fafc;
    border-color: #3b82f6;
    color: #0f172a;
}
QPushButton:pressed {
    background-color: #e2e8f0;
}
QPushButton:disabled {
    background-color: #f1f5f9;
    color: #94a3b8;
    border-color: #e2e8f0;
}

/* ---------- 주요 버튼 (생성) ---------- */
QPushButton#generateButton {
    background-color: #3b82f6;
    color: #ffffff;
    border: none;
    border-radius: 10px;
    padding: 12px 24px;
    font-size: 15px;
    font-weight: 600;
}
QPushButton#generateButton:hover {
    background-color: #2563eb;
}
QPushButton#generateButton:pressed {
    background-color: #1d4ed8;
}
QPushButton#generateButton:disabled {
    background-color: #93c5fd;
    color: #dbeafe;
}

/* ---------- 정지 버튼 ---------- */
QPushButton#stopButton {
    background-color: #ffffff;
    color: #b91c1c;
    border: 1px solid #fecaca;
}
QPushButton#stopButton:hover {
    background-color: #fee2e2;
    border-color: #ef4444;
}
QPushButton#stopButton:disabled {
    background-color: #f1f5f9;
    color: #94a3b8;
    border-color: #e2e8f0;
}
QPushButton#exitButton {
    font-size: 18px;
}

/* ---------- 프롬프트 향상 버튼 ---------- */
QPushButton#enhancePromptButton {
    background-color: #38bdf8;
    color: #0f172a;
    border: none;
    border-radius: 4px;
    padding: 4px 12px;
    font-weight: bold;
}
QPushButton#enhancePromptButton:hover {
    background-color: #0ea5e9;
}
QPushButton#enhancePromptButton:pressed {
    background-color: #0284c7;
}
QPushButton#enhancePromptButton:disabled {
    background-color: #475569;
    color: #94a3b8;
}

/* ---------- 도움말 탭 ---------- */
QTextBrowser#helpBrowser {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 16px;
    font-family: &quot;Segoe UI&quot;, &quot;Malgun Gothic&quot;, sans-serif;
    font-size: 13px;
    color: #1e293b;
}
QTextBrowser#helpBrowser QScrollBar:vertical {
    background-color: #f1f5f9;
    width: 10px;
    border-radius: 5px;
}
QTextBrowser#helpBrowser QScrollBar::handle:vertical {
    background-color: #cbd5e1;
    border-radius: 5px;
    min-height: 30px;
}
QTextBrowser#helpBrowser QScrollBar::handle:vertical:hover {
    background-color: #94a3b8;
}
QTextBrowser#helpBrowser QScrollBar::add-line:vertical,
QTextBrowser#helpBrowser QScrollBar::sub-line:vertical {
    height: 0px;
}

/* ---------- 프리셋 버튼 ---------- */
QPushButton#preset_512x512,
QPushButton#preset_768x768,
QPushButton#preset_1024x1024,
QPushButton#preset_832x1216,
QPushButton#preset_1216x832 {
    background-color: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 12px;
    font-weight: 500;
    color: #475569;
}
QPushButton#preset_512x512:hover,
QPushButton#preset_768x768:hover,
QPushButton#preset_1024x1024:hover,
QPushButton#preset_832x1216:hover,
QPushButton#preset_1216x832:hover {
    background-color: #eff6ff;
    border-color: #3b82f6;
    color: #1e293b;
}

/* ---------- 액션 버튼 ---------- */
QPushButton#resetButton,
QPushButton#loadConfigButton,
QPushButton#saveConfigButton,
QPushButton#restoreDefaultsButton,
QPushButton#exitButton,
QPushButton#lmCheckButton,
QPushButton#comfyCheckButton,
QPushButton#browseModelFolderButton,
QPushButton#openOutputFolderButton,
QPushButton#saveImageButton {
    background-color: #ffffff;
    border: 1px solid #d1d9e6;
}
QPushButton#resetButton:hover,
QPushButton#loadConfigButton:hover,
QPushButton#saveConfigButton:hover,
QPushButton#restoreDefaultsButton:hover,
QPushButton#exitButton:hover,
QPushButton#lmCheckButton:hover,
QPushButton#comfyCheckButton:hover,
QPushButton#browseModelFolderButton:hover,
QPushButton#openOutputFolderButton:hover,
QPushButton#saveImageButton:hover {
    background-color: #f8fafc;
    border-color: #3b82f6;
}

/* ---------- 프로그레스 바 ---------- */
QProgressBar {
    background-color: #e2e8f0;
    border: none;
    border-radius: 10px;
    height: 12px;
    text-align: center;
    color: #0f172a;
}
QProgressBar::chunk {
    background-color: #3b82f6;
    border-radius: 10px;
}
QProgressBar[value=&quot;100&quot;]::chunk {
    background-color: #10b981;
}

/* ---------- 로그 영역 ---------- */
QPlainTextEdit#logTextEdit {
    background-color: #0f172a;
    color: #cbd5e1;
    border: 1px solid #1e293b;
    border-radius: 12px;
    padding: 16px 18px;
    font-family: &quot;Cascadia Code&quot;, &quot;Consolas&quot;, &quot;Monaco&quot;, monospace;
    font-size: 13px;
    line-height: 1.8;
}
QPlainTextEdit#logTextEdit:focus {
    border-color: #475569;
    background-color: #0f172a;
}

/* ---------- 이미지 미리보기 ---------- */
QGroupBox#resultPanel {
    background-color: #f1f5f9;
    border: 1px solid #e9edf2;
    border-radius: 16px;
    padding: 12px;
}
QLabel#previewLabel {
    background-color: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    color: #94a3b8;
    padding: 20px;
}

/* ---------- 작은 서브 레이블 ---------- */
QLabel[text=&quot;📡 서버 주소&quot;],
QLabel[text=&quot;📦 모델 선택&quot;],
QLabel[text=&quot;📁 모델 폴더&quot;] {
    font-size: 12px;
    font-weight: 600;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

/* ---------- 스크롤바 ---------- */
QScrollBar:vertical {
    background-color: transparent;
    width: 8px;
    border-radius: 4px;
}
QScrollBar::handle:vertical {
    background-color: #cbd5e1;
    border-radius: 4px;
    min-height: 20px;
}
QScrollBar::handle:vertical:hover {
    background-color: #94a3b8;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar:horizontal {
    background-color: transparent;
    height: 8px;
    border-radius: 4px;
}
QScrollBar::handle:horizontal {
    background-color: #cbd5e1;
    border-radius: 4px;
    min-width: 20px;
}
QScrollBar::handle:horizontal:hover {
    background-color: #94a3b8;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}
/* ---------- FaceDetailer ON/OFF ---------- */

QCheckBox#facedetailerCheckBox::indicator {
    width: 22px;
    height: 22px;
    border-radius: 5px;
}

QCheckBox#facedetailerCheckBox::indicator:unchecked {
    background-color: #e2e8f0;
    border: 2px solid #94a3b8;
}

QCheckBox#facedetailerCheckBox::indicator:checked {
    background-color: #22c55e;
    border: 2px solid #16a34a;
}

QCheckBox#facedetailerCheckBox::indicator:checked:hover {
    background-color: #4ade80;
    border-color: #16a34a;
}</string>
