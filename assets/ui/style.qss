/* ============================================================
   ComfyCraft AI Easy Studio — Modern Dark Theme
   Based on DESIGN.md (Material You / Fluent Hybrid Palette)
   
   Palette:
   - Window / Surface:      #111319
   - Surface Container Low: #191b22
   - Surface Container:     #1e1f26
   - Surface Container High:#282a30
   - Border / Outline:      #33343b / #494454
   - Primary (Lavender):    #d0bcff (Text/Hover: #e9ddff, Pressed: #a078ff)
   - Secondary (Cyan):      #4cd7f6
   - Tertiary (Mint):       #4edea3
   - Text (On Surface):     #e2e2eb
   - Subtext (Variant):     #cbc3d7
   ============================================================ */

/* ---------- 전역 기본 설정 ---------- */
QMainWindow {
    background-color: #111319;
    color: #e2e2eb;
    font-family: "Segoe UI", "Malgun Gothic", "Pretendard", sans-serif;
}

QWidget#centralWidget {
    background-color: #111319;
}

QWidget {
    color: #e2e2eb;
    font-size: 13px;
}

QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* ---------- 스크롤바 ---------- */
QScrollBar:vertical {
    background: #111319;
    width: 6px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #33343b;
    min-height: 24px;
    border-radius: 3px;
}
QScrollBar::handle:vertical:hover {
    background: #958ea0;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

/* ---------- 상단 헤더 바 ---------- */
QFrame#headerFrame {
    background-color: #191b22;
    border: 1px solid #282a30;
    border-radius: 10px;
}

QLabel#appTitle {
    color: #e2e2eb;
    font-size: 16px;
    font-weight: 700;
}

QLabel#badgeLabel {
    background-color: rgba(78, 222, 163, 0.15);
    color: #4edea3;
    font-size: 11px;
    font-weight: 600;
    padding: 2px 8px;
    border-radius: 6px;
    border: 1px solid rgba(78, 222, 163, 0.3);
}

QFrame#headerDivider {
    color: #33343b;
    background-color: #33343b;
    width: 1px;
    max-width: 1px;
}

QPushButton#comfyStatusBtn, QPushButton#lmStatusBtn {
    background-color: #1e1f26;
    border: 1px solid #33343b;
    border-radius: 14px;
    padding: 4px 12px;
    color: #4edea3;
    font-size: 12px;
    font-weight: 500;
}
QPushButton#comfyStatusBtn:hover {
    background-color: #282a30;
    border-color: #4cd7f6;
    color: #4cd7f6;
}
QPushButton#lmStatusBtn:hover {
    background-color: #282a30;
    border-color: #d0bcff;
    color: #d0bcff;
}

QPushButton#helpButton, QPushButton#settingsButton {
    background-color: #1e1f26;
    border: 1px solid #33343b;
    border-radius: 8px;
    padding: 6px 12px;
    color: #e2e2eb;
    font-weight: 500;
}
QPushButton#helpButton:hover, QPushButton#settingsButton:hover {
    background-color: #282a30;
    border-color: #d0bcff;
    color: #d0bcff;
}

/* ---------- 카드 공통 스타일 ---------- */
QFrame#step1Card, QFrame#step2Card, QFrame#viewerCard, QFrame#historyCard, QFrame#faceDetailerCard, QFrame#enhancePromptCard {
    background-color: #191b22;
    border: 1px solid #282a30;
    border-radius: 12px;
}

QFrame#enhancePromptCard {
    background-color: #13151c;
    border: 1px solid #2a2c35;
}

/* ---------- 뱃지 및 타이틀 ---------- */
QLabel#step1Badge, QLabel#step2Badge {
    background-color: rgba(208, 188, 255, 0.2);
    color: #d0bcff;
    font-size: 12px;
    font-weight: 700;
    min-width: 22px;
    max-width: 22px;
    min-height: 22px;
    max-height: 22px;
    border-radius: 11px;
}

QLabel#step1Title, QLabel#step2Title, QLabel#viewerTitle, QLabel#historyTitle {
    color: #e2e2eb;
    font-size: 14px;
    font-weight: 600;
}

QLabel#positivePromptCounterLabel, QLabel#enhancePromptCounterLabel, QLabel#negativePromptCounterLabel, QLabel#elapsedLabel {
    color: #958ea0;
    font-size: 11px;
}

QLabel#modelProfileNoticeLabel {
    background-color: rgba(78, 222, 163, 0.15);
    color: #4edea3;
    font-size: 11px;
    padding: 2px 8px;
    border-radius: 6px;
}

/* ---------- 입력창 & 콤보박스 ---------- */
QPlainTextEdit {
    background-color: #111319;
    color: #e2e2eb;
    border: 1px solid #33343b;
    border-radius: 8px;
    padding: 8px;
    selection-background-color: #a078ff;
}
QPlainTextEdit:focus {
    border: 1px solid #d0bcff;
}

QComboBox {
    background-color: #111319;
    color: #e2e2eb;
    border: 1px solid #33343b;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 12px;
    outline: none;
}
QComboBox:hover {
    border: 1px solid #4cd7f6;
}
QComboBox:focus {
    border: 1px solid #d0bcff;
}
QComboBox::drop-down {
    border: none;
    width: 24px;
}
QComboBox QAbstractItemView {
    background-color: #1e1f26;
    color: #e2e2eb;
    border: 1px solid #33343b;
    selection-background-color: #373940;
    selection-color: #d0bcff;
    padding: 4px;
}

QSpinBox, QDoubleSpinBox {
    background-color: #111319;
    color: #e2e2eb;
    border: 1px solid #33343b;
    border-radius: 6px;
    padding: 3px 6px;
    font-size: 12px;
    outline: none;
}
QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #d0bcff;
}

/* ---------- 버튼 스타일 ---------- */
QPushButton {
    background-color: #1e1f26;
    color: #e2e2eb;
    border: 1px solid #33343b;
    border-radius: 8px;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 500;
}
QPushButton:hover {
    background-color: #282a30;
    border-color: #494454;
    color: #ffffff;
}
QPushButton:pressed {
    background-color: #0c0e14;
}

/* AI 마법사 버튼 */
QPushButton#enhancePromptButton {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #6d3bd7, stop:1 #03b5d3);
    color: #ffffff;
    font-size: 13px;
    font-weight: 600;
    border: none;
    border-radius: 8px;
    padding: 8px 14px;
}
QPushButton#enhancePromptButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #8250f0, stop:1 #05d0f2);
}

/* 복사 버튼 */
QPushButton#copyPromptButton {
    background-color: #1e1f26;
    border: 1px solid #33343b;
    border-radius: 6px;
    padding: 3px 8px;
    font-size: 11px;
    color: #cbc3d7;
}
QPushButton#copyPromptButton:hover {
    border-color: #d0bcff;
    color: #d0bcff;
}

/* 해상도 프리셋 버튼 3종 */
QPushButton#preset_1024x1024, QPushButton#preset_896x1152, QPushButton#preset_1152x896 {
    background-color: #111319;
    border: 1px solid #282a30;
    border-radius: 8px;
    padding: 8px 6px;
    font-size: 11px;
    color: #cbc3d7;
}
QPushButton#preset_1024x1024:hover, QPushButton#preset_896x1152:hover, QPushButton#preset_1152x896:hover {
    background-color: #1e1f26;
    border-color: #4cd7f6;
    color: #e2e2eb;
}

/* 뷰어 하단 액션 버튼 */
QPushButton#saveImageButton, QPushButton#copyImageButton, QPushButton#openOutputFolderButton {
    background-color: #1e1f26;
    border: 1px solid #33343b;
    border-radius: 8px;
    font-size: 12px;
}
QPushButton#saveImageButton:hover { border-color: #d0bcff; color: #d0bcff; }
QPushButton#copyImageButton:hover { border-color: #4cd7f6; color: #4cd7f6; }
QPushButton#openOutputFolderButton:hover { border-color: #4edea3; color: #4edea3; }

/* 시드 제어 버튼 */
QPushButton#randomSeedButton, QPushButton#lockSeedButton {
    background-color: #1e1f26;
    border: 1px solid #33343b;
    border-radius: 6px;
    font-size: 11px;
    padding: 4px 8px;
}
QPushButton#lockSeedButton:checked {
    background-color: rgba(208, 188, 255, 0.2);
    border-color: #d0bcff;
    color: #d0bcff;
}

/* 고급 설정 토글 버튼 */
QPushButton#advancedToggleBtn {
    background-color: #1e1f26;
    border: 1px solid #282a30;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 12px;
    font-weight: 600;
    color: #d0bcff;
    text-align: left;
}
QPushButton#advancedToggleBtn:hover {
    background-color: #282a30;
}

/* ---------- 슬라이더 (QSlider) ---------- */
QSlider::groove:horizontal {
    border: none;
    height: 6px;
    background: #282a30;
    border-radius: 3px;
}
QSlider::sub-page:horizontal {
    background: #d0bcff;
    border-radius: 3px;
}
QSlider#cfgSlider::sub-page:horizontal {
    background: #4cd7f6;
}
QSlider::handle:horizontal {
    background: #ffffff;
    border: 2px solid #d0bcff;
    width: 16px;
    height: 16px;
    margin: -5px 0;
    border-radius: 8px;
}
QSlider#cfgSlider::handle:horizontal {
    border: 2px solid #4cd7f6;
}
QSlider::handle:horizontal:hover {
    background: #e9ddff;
}

/* ---------- 체크박스 (FaceDetailer 등) ---------- */
QCheckBox {
    spacing: 8px;
    color: #e2e2eb;
    font-weight: 600;
    font-size: 13px;
}
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 1px solid #494454;
    background-color: #111319;
}
QCheckBox::indicator:hover {
    border-color: #d0bcff;
}
QCheckBox::indicator:checked {
    background-color: #a078ff;
    border-color: #a078ff;
}

/* ---------- 이미지 프리뷰 영역 ---------- */
QLabel#previewLabel {
    background-color: #0c0e14;
    border: 1px solid #282a30;
    border-radius: 10px;
    color: #958ea0;
}

/* ---------- 프로그레스 바 ---------- */
QProgressBar {
    background-color: #282a30;
    border: none;
    border-radius: 4px;
    height: 8px;
}
QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #4cd7f6, stop:1 #4edea3);
    border-radius: 4px;
}

/* ---------- 썸네일 그리드 버튼 ---------- */
QPushButton#thumbBtn_0, QPushButton#thumbBtn_1, QPushButton#thumbBtn_2, QPushButton#thumbBtn_3 {
    background-color: #111319;
    border: 1px solid #282a30;
    border-radius: 8px;
    color: #757575;
    font-size: 11px;
}
QPushButton#thumbBtn_0:hover, QPushButton#thumbBtn_1:hover, QPushButton#thumbBtn_2:hover, QPushButton#thumbBtn_3:hover {
    border-color: #d0bcff;
    border-width: 2px;
}

/* ---------- 하단 접이식 로그창 ---------- */
QFrame#logSectionFrame {
    background-color: transparent;
}
QPushButton#toggleLogButton {
    background-color: #191b22;
    border: 1px solid #282a30;
    border-radius: 6px;
    color: #958ea0;
    font-size: 11px;
    padding: 4px 10px;
}
QPushButton#toggleLogButton:hover {
    color: #e2e2eb;
    border-color: #494454;
}
QPushButton#resetButton {
    background-color: #191b22;
    border: 1px solid #282a30;
    border-radius: 6px;
    color: #958ea0;
    font-size: 11px;
    padding: 4px 10px;
}
QPushButton#resetButton:hover {
    color: #ffb4ab;
    border-color: #93000a;
}
QGroupBox#logGroupBox {
    border: 1px solid #282a30;
    border-radius: 8px;
    background-color: #0c0e14;
}
QPlainTextEdit#logTextEdit {
    background-color: transparent;
    border: none;
    color: #a0a0b0;
    font-family: "Consolas", "Cascadia Code", monospace;
    font-size: 11px;
}
